# Copy to .env.local and fill in. NEVER commit real values.
# On Vercel these are set by the Supabase marketplace integration.

# Engine + data scripts
DATABASE_URL=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
SUPABASE_URL=
# admin key, server-side only: seed_users.py, and the engine's site-video storage (T123)
SUPABASE_SERVICE_ROLE_KEY=
# site visits (T123/T124): signs capture tokens (16+ characters); the storage bucket for videos
DRISHTI_CAPTURE_SECRET=
# DRISHTI_VIDEO_BUCKET=site-visits
# the video job only, optional (the owner's free key): judges the agency's claims
# GEMINI_API_KEY=

# Web (public values)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local development
# DRISHTI_AUTH=dev
# NEXT_PUBLIC_DEV_ROLE=MINISTRY
# NEXT_PUBLIC_DEV_DISTRICT=
# DRISHTI_SNAPSHOT_DATE=2026-05-26
# DRISHTI_OLD_REPO=
